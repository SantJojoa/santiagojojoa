---
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).analyzer;
// El script del cliente lee este JSON; "<" escapado para que no pueda cerrar la etiqueta.
const i18n = JSON.stringify(t).replace(/</g, "\\u003c");
---

<div id="analyzer" data-analyzer-tool data-lang={lang}>
    <form data-form data-reveal novalidate>
        <label for="analyzer-url" class="sr-only">{t.form.label}</label>
        <div class="glass-1 nav-solid flex flex-col gap-3 p-3 sm:flex-row">
            <input
                id="analyzer-url"
                name="url"
                type="text"
                inputmode="url"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                maxlength="2048"
                placeholder={t.form.placeholder}
                class="min-w-0 flex-1 rounded-2xl bg-transparent px-5 py-4 text-lg text-white outline-none placeholder:text-white/30 focus-visible:ring-2 focus-visible:ring-accent/60"
            />
            <button
                type="submit"
                data-submit
                class="rounded-full bg-white px-8 py-4 font-medium text-black transition-opacity disabled:opacity-60"
            >
                {t.form.submit}
            </button>
        </div>
    </form>

    <p data-reveal class="mt-5 max-w-2xl text-xs leading-relaxed text-white/40">
        {t.notice} {t.privacy}
    </p>

    <div data-error role="alert" hidden class="mt-6 rounded-2xl border border-danger/40 bg-danger/10 px-5 py-4 text-sm text-white"></div>

    <div data-loading hidden aria-live="polite" class="mt-8">
        <div class="analyzer-scan h-1 overflow-hidden rounded-full bg-white/10"></div>
        <p class="mt-3 text-sm text-white/50">{t.form.submitting}</p>
    </div>

    <div data-results tabindex="-1" aria-live="polite" class="mt-10 scroll-mt-28 outline-none"></div>

    <script is:inline type="application/json" id="analyzer-i18n" set:html={i18n} />
    <script>
        import "../../scripts/analyzer-ui";
    </script>
</div>
