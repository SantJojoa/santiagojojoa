---
import SectionHeading from "../ui/SectionHeading.astro";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).projects;
---

<!-- Sin JS (o con movimiento reducido) la pista es un carrusel con scroll
     horizontal nativo. Con JS, projects.ts la convierte en scroll horizontal
     controlado por el scroll vertical (sticky, no fixed). -->
<section id="projects" data-projects class="relative">
    <div data-projects-sticky class="flex flex-col justify-center py-32">
        <div class="mx-auto w-full max-w-6xl px-6">
            <SectionHeading eyebrow={t.eyebrow} title={t.title} />
        </div>

        <div
            data-projects-track
            class="mt-14 flex snap-x gap-6 overflow-x-auto px-6 pb-4 md:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))]"
        >
            {
                t.items.map((item, i) => (
                    <article
                        data-tilt
                        class="glass-1 flex h-[380px] w-[82vw] shrink-0 snap-center flex-col p-8 md:w-[460px]"
                    >
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-medium text-accent">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <span class="rounded-full border border-white/15 px-3 py-1 text-xs text-white/70">
                                {item.tag}
                            </span>
                        </div>
                        <h3 class="mt-auto text-3xl font-semibold leading-tight tracking-[-0.025em]">
                            {item.title}
                        </h3>
                        <p class="mt-3 leading-relaxed text-white/60">
                            {item.description}
                        </p>
                        {item.url ? (
                            <a
                                href={item.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent after:absolute after:inset-0 after:content-['']"
                            >
                                {t.visit}
                                <span aria-hidden="true">↗</span>
                            </a>
                        ) : (
                            <span class="mt-6 inline-flex w-fit rounded-full border border-accent/40 px-3 py-1 text-xs font-medium text-accent">
                                {t.inProgress}
                            </span>
                        )}
                    </article>
                ))
            }
            <div class="w-px shrink-0 md:w-[max(1.5rem,calc((100vw-72rem)/2))]" aria-hidden="true"></div>
        </div>
    </div>
</section>
