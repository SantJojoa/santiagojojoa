---
import { links } from "../../config";
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).hero;

const items = [
    {
        href: links.github,
        label: t.ctaGithub,
        // GitHub (simple-icons)
        path: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z",
    },
    {
        href: links.linkedin,
        label: t.ctaLinkedin,
        // LinkedIn
        path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    },
];
---

<div class="flex flex-wrap items-center justify-center gap-3">
    {
        items.map((item) => (
            <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                data-magnetic
                class="glass-2 nav-solid inline-flex items-center gap-2.5 px-6 py-3 text-sm font-medium text-white transition-[scale] duration-[var(--duration-fast)] ease-[var(--ease-apple)] hover:scale-[1.04]"
            >
                <svg
                    viewBox="0 0 24 24"
                    class="h-5 w-5"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d={item.path} />
                </svg>
                {item.label}
            </a>
        ))
    }
</div>
